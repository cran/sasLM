\name{Min}
\alias{Min}
\title{Min without NA}
\description{
  Minimum without \code{NA} values.
}
\usage{
  Min(y)
}
\arguments{
  \item{y}{a vector of numerics}
}
\details{
  It removes \code{NA} values from the input vector.
}
\value{
  minimum value
}
