\name{Max}
\alias{Max}
\title{Max without NA}
\description{
  Maximum without \code{NA} values.
}
\usage{
  Max(y)
}
\arguments{
  \item{y}{a vector of numerics}
}
\details{
  It removes \code{NA} values from the input vector.
}
\value{
  maximum value
}
