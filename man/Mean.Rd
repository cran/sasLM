\name{Mean}
\alias{Mean}
\title{Mean without NA}
\description{
  Mean without \code{NA} values.
}
\usage{
  Mean(y)
}
\arguments{
  \item{y}{a vector of numerics}
}
\details{
  It removes \code{NA} values from the input vector.
}
\value{
  mean value
}
